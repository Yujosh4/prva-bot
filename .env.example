# Copy this file to .env for local testing. On Railway (or wherever you host this),
# set these as real environment variables in the dashboard instead of a file —
# never commit a real .env or paste your bot token anywhere public.

# From Discord Developer Portal → your application → Bot → Token
DISCORD_TOKEN=

# From Discord Developer Portal → your application → General Information → Application ID
DISCORD_CLIENT_ID=

# Right-click your PRVA server icon → Copy Server ID (enable Developer Mode in
# Discord settings first: Advanced → Developer Mode)
GUILD_ID=

# The #pilot-applications forum channel (right-click it → Copy Channel ID)
PILOT_APPLICATIONS_FORUM_CHANNEL_ID=

# Right-click your Staff role in Server Settings → Roles → Copy Role ID
STAFF_ROLE_ID=

# Shared secret the website's Join Us form sends in an X-PRVA-Key header when it POSTs a
# pilot application to this bot's /pilot-application endpoint. Make up any string — it just
# has to match exactly what you put in join.html's PILOT_APP_API_KEY constant. Not a real
# secret (it's visible in the website's page source either way), just keeps casual scanners
# off the endpoint.
PILOT_APP_API_KEY=

# Port the HTTP server (for /pilot-application) listens on. On Wispbyte this is usually
# provided automatically as SERVER_PORT — leave this blank unless you need to override it.
PORT=
